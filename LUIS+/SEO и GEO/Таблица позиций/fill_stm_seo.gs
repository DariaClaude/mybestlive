function fillStmSeo() {
  var ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  var sheet = ss.getSheets().filter(function (s) { return s.getSheetId() == SHEET_GID; })[0];
  if (!sheet) { Logger.log('Лист не найден'); return; }

  var rows = 0, top = 0;
  var green = function (v) { return (typeof v === 'number') ? GREEN : null; };

  Object.keys(STM).forEach(function (r) {
    var row = parseInt(r, 10);
    var v   = STM[r];                 // [LTV, LPA, ЛПТ]
    var rng = sheet.getRange(row, COL_LTV, 1, 3);  // F,G,H
    rng.setValues([v]);
    rng.setBackgrounds([v.map(green)]);
    rows++;
    v.forEach(function (x) { if (typeof x === 'number') top++; });
  });

  SpreadsheetApp.flush();
  Logger.log('=== СТМ SEO готово. Строк: ' + rows + ' | позиций в топ-100: ' + top + ' ===');
}
