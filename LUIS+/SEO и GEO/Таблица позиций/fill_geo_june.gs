];

// LUIS+ каждого движка (F,M,T) и остальные 5 брендов на движок
var LUIS_COLS  = [6, 13, 20];
var OTHER_COLS = [7,8,9,10,11, 14,15,16,17,18, 21,22,23,24,25];

function fillGeoJune() {
  var ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  var sheet = ss.getSheets().filter(function (s) { return s.getSheetId() == SHEET_GID; })[0];
  if (!sheet) { Logger.log('Лист не найден'); return; }
  var grid = sheet.getDataRange().getValues();

  var mn = {};
  Object.keys(MEASURED).forEach(function (k) { mn[norm(k)] = MEASURED[k]; });

  var pos = 0, dash = 0, nf = [];
  KEYS.forEach(function (key) {
    var r = findRow(grid, key);
    if (r < 0) { nf.push(key); return; }
    if (!isBlank(grid[r][5])) return; // ChatGPT/LUIS+ занят — строку пропускаем

    var val = mn.hasOwnProperty(norm(key)) ? mn[norm(key)] : '-';
    LUIS_COLS.forEach(function (c) { if (isBlank(grid[r][c - 1])) sheet.getRange(r + 1, c).setValue(val); });
    OTHER_COLS.forEach(function (c) { if (isBlank(grid[r][c - 1])) sheet.getRange(r + 1, c).setValue('-'); });

    if (val !== '-') { pos++; Logger.log('★ ' + key + ' → ' + val); } else { dash++; }
  });

  SpreadsheetApp.flush();
  Logger.log('=== Готово: с позицией ' + pos + ', "-" ' + dash + ', не найдено ' + nf.length + ' ===');
  if (nf.length) Logger.log('НЕ НАЙДЕНЫ: ' + nf.join(' | '));
}

function norm(v) { return String(v).toLowerCase().replace(/\s+/g, ' ').trim(); }
function findRow(grid, key) { var t = norm(key); for (var r = 0; r < grid.length; r++) if (norm(grid[r][1]) === t) return r; return -1; }
function isBlank(v) { var s = String(v).trim(); return s === '' || s === '—' || s === '-'; }
