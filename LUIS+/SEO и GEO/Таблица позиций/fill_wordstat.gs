function fillWordstat() {
  var ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  var sheet = ss.getSheetByName(TARGET_SHEET);
  if (!sheet) { Logger.log('Лист не найден'); return; }
  var last = sheet.getLastRow();
  var colA = sheet.getRange(1, QCOL, last, 1).getValues();
  var colB = sheet.getRange(1, VCOL, last, 1).getValues();
  var set = 0, notfound = 0, out = [];
  for (var r = 0; r < last; r++) {
    var a = String(colA[r][0] == null ? '' : colA[r][0]).trim();
    var na = norm(a);
    if (!na || /^\d+\.\s/.test(a)) { out.push([colB[r][0]]); continue; }
    if (Object.prototype.hasOwnProperty.call(FREQ, na)) { out.push([FREQ[na]]); set++; }
    else { out.push([colB[r][0]]); notfound++; }
  }
  sheet.getRange(1, VCOL, last, 1).setValues(out);
  SpreadsheetApp.flush();
  Logger.log('Проставлено частот: ' + set + ', не найдено в выгрузке: ' + notfound);
}
function norm(v) { return String(v == null ? '' : v).toLowerCase().replace(/\s+/g, ' ').trim(); }
