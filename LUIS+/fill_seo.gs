function fillSeo() {
  var ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  var sheet = ss.getSheets().filter(function (s) { return s.getSheetId() == SHEET_GID; })[0];
  if (!sheet) { Logger.log('Лист не найден'); return; }

  // Шапка SEO-блока конкурентов (строка 1 — "SEO", строка 3 — домены)
  var hdr = sheet.getRange(1, COL_COMP1, 1, DOMAINS.length);
  if (!hdr.isPartOfMerge()) hdr.merge();
  hdr.setValue('SEO').setHorizontalAlignment('center').setFontWeight('bold');
  sheet.getRange(3, COL_COMP1, 1, DOMAINS.length).setValues([DOMAINS]).setFontWeight('bold');

  var rows = 0, top = 0;
  var green = function (v) { return (typeof v === 'number') ? GREEN : null; };

  Object.keys(SEO).forEach(function (r) {
    var row  = parseInt(r, 10);
    var vals = SEO[r];
    var luis = vals[0];
    var comp = vals.slice(1);

    // C = luis.ru
    var cL = sheet.getRange(row, COL_LUIS);
    cL.setValue(luis);
    cL.setBackground(green(luis));

    // Z..AM = конкуренты
    var rng = sheet.getRange(row, COL_COMP1, 1, comp.length);
    rng.setValues([comp]);
    rng.setBackgrounds([comp.map(green)]);

    rows++;
    vals.forEach(function (v) { if (typeof v === 'number') top++; });
  });

  SpreadsheetApp.flush();
  Logger.log('=== SEO готово. Строк: ' + rows + ' | позиций в топ-100: ' + top + ' ===');
}
