function fillCompetitorsGeo() {
  var ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  var sheet = ss.getSheets().filter(function (s) { return s.getSheetId() == SHEET_GID; })[0];
  if (!sheet) { Logger.log('Лист не найден'); return; }

  // --- Шапка нового блока ---
  // Строка 1: объединённый заголовок "GEO" над AO..BB
  var hdr = sheet.getRange(1, FIRST_COL, 1, DOMAINS.length);
  if (!hdr.isPartOfMerge()) hdr.merge();
  hdr.setValue('GEO').setHorizontalAlignment('center').setFontWeight('bold');
  // Строка 3: имена доменов
  sheet.getRange(3, FIRST_COL, 1, DOMAINS.length).setValues([DOMAINS]).setFontWeight('bold');

  // --- Данные ---
  var rows = 0, hits = 0;
  Object.keys(COMP).forEach(function (r) {
    var row = parseInt(r, 10);
    var vals = COMP[r];
    var bg = vals.map(function (v) { return v !== '-' ? GREEN : null; });
    var rng = sheet.getRange(row, FIRST_COL, 1, vals.length);
    rng.setValues([vals]);
    rng.setBackgrounds([bg]);   // числовые позиции — светло-зелёная заливка
    rows++;
    vals.forEach(function (v) { if (v !== '-') hits++; });
  });

  SpreadsheetApp.flush();
  Logger.log('=== Готово. Строк: ' + rows + ' | реальных позиций: ' + hits + ' ===');
}
