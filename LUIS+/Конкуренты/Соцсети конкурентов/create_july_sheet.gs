 * Данные собраны ГЛУБОКОЙ пагинацией лент t.me/s/ (?before= до 30 июня) +
 * сверкой дат по embed-страницам каждого поста + поиском по сайтам/VK/СМИ.
 * Это устраняет «провал» веб-среза, который отдаёт лишь ~20 последних постов.
 *
 * Функция run():
 *   1. Вкладка «Июль 2026»            — сводная по 22 конкурентам, ПОЛНЫЕ объёмы (с гиперссылками)
 *   2. Вкладка «Раскладка июль 2026»  — ВСЕ публикации 22 конкурентов, сортировка по охвату ↓,
 *                                       колонка «По теме» (✓ профиль LUIS+ / ~ смежное / — электротехника)
 *   3. Единая цветовая палитра охвата для всех листов «Раскладка*»
 *
 * Гиперссылки — через RichText (setLinkUrl): локаль-независимо, без #ERROR!
 * Ссылки в раскладке ведут на КОНКРЕТНЫЙ пост/статью (Telegram — на сообщение, сайты — на permalink).
 * ЗАПУСК: script.google.com → вставить код → выбрать run → ▶ Выполнить.
 * Период данных: 1–28 июля 2026. Скрипт безопасен для повторного запуска.
 */

var SPREADSHEET_ID = '1oPpimp0DoHNmd6cTjBdrHeM2tb-0OsAbEhaGF9Xhmg4';

// ── ЕДИНАЯ ПАЛИТРА ОХВАТА (общая для всех месяцев) ──
var PALETTE = {
  high: '#e8f5e9',  // ≥ 2 000
  good: '#fff8e1',  // 1 500 – 1 999
  mid:  '#f3e5f5',  // 1 000 – 1 499
  low:  '#e3f2fd',  // 500 – 999
  min:  '#f5f5f5',  // < 500
  none: '#f9f9f9'   // нет данных
};

function bgForReach(v) {
  if (v === '' || v === null || v === undefined) return PALETTE.none;
  var n = (typeof v === 'number') ? v : parseInt(String(v).replace(/[^\d]/g, ''), 10);
  if (isNaN(n)) return PALETTE.none;
  if (n >= 2000) return PALETTE.high;
  if (n >= 1500) return PALETTE.good;
  if (n >= 1000) return PALETTE.mid;
  if (n >= 500)  return PALETTE.low;
  return PALETTE.min;
}

// Универсальная гиперссылка через RichText (без ошибок локали)
function setLink(s, row, col, text, url) {
  var rt = SpreadsheetApp.newRichTextValue()
    .setText(text)
    .setLinkUrl(url)
    .build();
  s.getRange(row, col).setRichTextValue(rt);
}

function run() {
  var ss = SpreadsheetApp.openById(SPREADSHEET_ID);

  ['Июль 2026', 'Раскладка июль 2026'].forEach(function(name) {
    var old = ss.getSheetByName(name);
    if (old) ss.deleteSheet(old);
  });

  var mainSheet = ss.insertSheet('Июль 2026');
  var razSheet  = ss.insertSheet('Раскладка июль 2026');

  buildMainSheet(mainSheet);
  buildRazkladkaSheet(razSheet);

  var processed = unifyRazkladkaPalette(ss);   // единая палитра для всех раскладок

  ss.setActiveSheet(mainSheet);
  Logger.log('Готово. Единая палитра применена к листам: ' + processed.join(' | '));
}

