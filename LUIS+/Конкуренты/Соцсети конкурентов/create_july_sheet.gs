    .setWrapStrategy(SpreadsheetApp.WrapStrategy.WRAP);

  s.getRange(startRow, 1, posts.length, 1).setHorizontalAlignment('center'); // #
  s.getRange(startRow, 3, posts.length, 2).setHorizontalAlignment('center'); // Дата, Платформа
  s.getRange(startRow, 7, posts.length, 1).setHorizontalAlignment('center'); // По теме
  s.getRange(startRow, 8, posts.length, 1).setHorizontalAlignment('center'); // Охват
  s.getRange(startRow, 9, posts.length, 1).setHorizontalAlignment('center'); // Ссылка

  // цвет тега «По теме» + жирный охват у топовых
  var tagColor = { '✓': '#1b5e20', '~': '#1565c0', '—': '#9e9e9e' };
  for (var i = 0; i < posts.length; i++) {
    var row = startRow + i;
    s.getRange(row, 7).setFontColor(tagColor[posts[i][7]] || '#9e9e9e').setFontWeight('bold');
    if (posts[i][5] !== '' && posts[i][5] >= 1500) s.getRange(row, 8).setFontWeight('bold');
  }

  // ── ЛЕГЕНДА ──
  var legRow = startRow + posts.length + 1;
  s.getRange(legRow, 1, 1, 4).merge()
    .setValue('ЛЕГЕНДА — ОХВАТ (ПРОСМОТРЫ)')
    .setBackground('#1a1a1a').setFontColor('#ffffff')
    .setFontWeight('bold').setFontSize(10).setHorizontalAlignment('center');

  var legend = [
    ['≥ 2 000 — Высокий охват', PALETTE.high],
    ['1 500 – 1 999 — Хороший',  PALETTE.good],
    ['1 000 – 1 499 — Средний',  PALETTE.mid],
    ['500 – 999 — Ниже среднего', PALETTE.low],
    ['< 500 — Низкий',           PALETTE.min],
    ['Нет данных (сайт/VK)',     PALETTE.none]
  ];
  legend.forEach(function(item, i) {
    s.getRange(legRow + 1 + i, 1, 1, 4).merge()
      .setValue(item[0]).setBackground(item[1])
      .setFontSize(10).setHorizontalAlignment('center');
  });

  // ── ИТОГО ПО РАСКЛАДКЕ ──
  var sumRow = legRow + legend.length + 3;
  s.getRange(sumRow, 1, 1, 6).merge()
    .setValue('ИТОГО: ' + posts.length + ' публикаций за июль — ' +
              '✓ по теме LUIS+ ' + (cnt['✓'] || 0) + ' · ~ смежное ' + (cnt['~'] || 0) +
              ' · — электротехника/электротовары ' + (cnt['—'] || 0) +
              '. Реальные конкуренты по нашей теме: Рубеж (17), Болид (4), Аргус (3), TRASSIR / Parsec (3–4).')
    .setBackground('#eceff1').setFontColor('#37474f').setFontStyle('italic')
    .setFontSize(10).setWrapStrategy(SpreadsheetApp.WrapStrategy.WRAP)
    .setVerticalAlignment('middle');
  s.setRowHeight(sumRow, 46);
}

// ═══════════════════════════════════════════════════════════
//  ЕДИНАЯ ПАЛИТРА ДЛЯ ВСЕХ ЛИСТОВ «Раскладка*»
// ═══════════════════════════════════════════════════════════
function unifyRazkladkaPalette(ss) {
  var processed = [];
  ss.getSheets().forEach(function(sh) {
    if (sh.getName().toLowerCase().indexOf('раскладка') < 0) return;
    if (recolorRazkladka(sh)) processed.push(sh.getName());
  });
  return processed;
}

function recolorRazkladka(s) {
  var lastCol = s.getLastColumn();
  var lastRow = s.getLastRow();
  if (lastCol < 2 || lastRow < 2) return false;

  var header = s.getRange(1, 1, 1, lastCol).getValues()[0];
  var reachCol = -1;
  for (var i = 0; i < header.length; i++) {
    var h = String(header[i]).toLowerCase();
    if (h.indexOf('хват') >= 0 || h.indexOf('росмотр') >= 0) { reachCol = i + 1; break; }
  }
  if (reachCol < 0) return false;

  s.getRange(1, 1, 1, lastCol)
    .setBackground('#1a1a1a').setFontColor('#ffffff').setFontWeight('bold');

  var names   = s.getRange(1, 1, lastRow, 1).getValues();
  var reaches = s.getRange(1, reachCol, lastRow, 1).getValues();
  for (var r = 2; r <= lastRow; r++) {
    var nm = names[r - 1][0];
    if (nm === '' || nm === null) continue;                     // пустые/разрывные строки
    if (/^(Все публикации|Только контент)/i.test(String(nm))) continue; // строка-пояснение под шапкой (СНАЧАЛА)
    if (/ПРОСМОТР|ПЛАТФОРМА|ЛЕГЕНД|ОХВАТ|ГИГАНТ|КОМПАНИЯ|ИТОГО|^≥|^</i.test(String(nm))) break; // блоки легенды/итогов
    s.getRange(r, 1, 1, lastCol).setBackground(bgForReach(reaches[r - 1][0]));
  }
  return true;
}
