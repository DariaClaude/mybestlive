function norm(v){ return String(v==null?'':v).toLowerCase().replace(/\s+/g,' ').trim(); }

function fillGeoAll() {
  var ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  var sheet = ss.getSheetByName(TARGET_SHEET);
  if (!sheet) { Logger.log('Лист не найден'); return; }
  var last = sheet.getLastRow();
  var A  = sheet.getRange(1, QCOL, last, 1).getValues();
  var cg = sheet.getRange(1, 5,  last, 6).getValues();   // ChatGPT  E:J
  var gm = sheet.getRange(1, 12, last, 6).getValues();   // Gemini   L:Q
  var pp = sheet.getRange(1, 19, last, 6).getValues();   // Perplexity S:X
  var cgB = sheet.getRange(1, 5,  last, 6).getBackgrounds();
  var gmB = sheet.getRange(1, 12, last, 6).getBackgrounds();
  var ppB = sheet.getRange(1, 19, last, 6).getBackgrounds();

  var pos = 0;
  for (var r = 4; r < last; r++) {
    var a = String(A[r][0] == null ? '' : A[r][0]).trim();
    if (!a || /^\d+\.\s/.test(a)) continue;
    if (a.indexOf('.') >= 0 && a.indexOf(' ') < 0) continue;
    var na = norm(a);
    var val = MEASURED.hasOwnProperty(na) ? MEASURED[na] : '-';
    cg[r] = [val,'-','-','-','-','-']; gm[r] = [val,'-','-','-','-','-']; pp[r] = [val,'-','-','-','-','-'];
    var green = (val !== '-') ? '#d9ead3' : '#ffffff';
    cgB[r][0] = green; gmB[r][0] = green; ppB[r][0] = green;
    if (val !== '-') pos++;
  }
  sheet.getRange(1, 5,  last, 6).setValues(cg);
  sheet.getRange(1, 12, last, 6).setValues(gm);
  sheet.getRange(1, 19, last, 6).setValues(pp);
  sheet.getRange(1, 5,  last, 6).setBackgrounds(cgB);
  sheet.getRange(1, 12, last, 6).setBackgrounds(gmB);
  sheet.getRange(1, 19, last, 6).setBackgrounds(ppB);
  SpreadsheetApp.flush();
  Logger.log('GEO: позиций ' + pos + ' (светло-зелёные), остальные "-".');
}