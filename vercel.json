{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/war-room-matrix"
    },
    {
      "source": "/luis",
      "destination": "/luis-dashboard"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    }
  ]
}
