function fillJuneTab() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(SHEET_JUNE) || ss.insertSheet(SHEET_JUNE);

  sh.clear();
  sh.getRange(1, 1, JUNE_HEAD.length, 8).setValues(JUNE_HEAD);
  sh.getRange(JUNE_HEAD.length + 1, 1, JUNE_ROWS.length, 8).setValues(JUNE_ROWS);

  // оформление
  sh.getRange(1, 1, 1, 8).setFontWeight('bold').setBackground('#f0f0f0');
  sh.getRange(2, 1, 2, 1).setFontStyle('italic');
  sh.setColumnWidth(1, 300);
  sh.setColumnWidth(2, 120);
  sh.getRange(1, 3, JUNE_HEAD.length + JUNE_ROWS.length, 6).setHorizontalAlignment('center');
  sh.setFrozenRows(1);

  SpreadsheetApp.getUi().alert(
    'Вкладка «Июнь(26)» заполнена: ' + JUNE_ROWS.length + ' ключей.\n\n' +
    'Осталось внести вручную (PR-CY их не отдаёт):\n' +
    '— Посещения за последний месяц (PMExcellence) из Яндекс Метрики'
  );
}

function fillAiJuly() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(SHEET_AI);
  if (!sh) { SpreadsheetApp.getUi().alert('Лист «' + SHEET_AI + '» не найден'); return; }

  var col = sh.getLastColumn() + 2; // отступ в одну пустую колонку от прошлого блока

  sh.getRange(1, col).setValue('Веб-замер живой выдачи 13.07.2026');
  sh.getRange(2, col, 1, 5).setValues([['PMExcellence', 'BaseLine', 'Айбим', 'Проектная практика', 'PM Soft']]);
  sh.getRange(1, col, 1, 5).merge().setFontWeight('bold').setBackground('#f0f0f0').setHorizontalAlignment('center');
  sh.getRange(2, col, 1, 5).setFontWeight('bold');

  // ищем строку каждого запроса по столбцу B и пишем позиции в новый блок
  var keys = sh.getRange(1, 2, sh.getLastRow(), 1).getValues();
  var written = 0;

  for (var i = 0; i < GEO_ROWS.length; i++) {
    var q = String(GEO_ROWS[i][0]).trim().toLowerCase();
    for (var r = 0; r < keys.length; r++) {
      if (String(keys[r][0]).trim().toLowerCase() === q) {
        sh.getRange(r + 1, col, 1, 5).setValues([GEO_ROWS[i].slice(1)]);
        written++;
        break;
      }
    }
  }

  sh.getRange(2, col, 1, 5).setHorizontalAlignment('center');
  SpreadsheetApp.getUi().alert(
    'Блок GEO добавлен: ' + written + ' из ' + GEO_ROWS.length + ' запросов размечено.\n\n' +
    'ВАЖНО: это ОДИН срез живой выдачи, а не 5 разных движков. ' +
    'Позиции по ChatGPT / Perplexity / DeepSeek / ГигаЧат / Claude по отдельности снимаются вручную в каждом чате.'
  );
}
